# OpenRouter API Key (for LLM and embeddings)
OPENROUTER_API_KEY=<<LLM-API-KEY>>

# OpenWeatherMap API Key
OPENWEATHERMAP_API_KEY=<<OpenWeatherMap-API-KEY>>

# LangSmith Configuration
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=<<LangSmith-API-KEY>>
LANGSMITH_PROJECT=ai-pipeline-project

# Qdrant Configuration (local Docker instance - no API key required)
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=your_qdrant_api_key_here  # Not required for local instance
